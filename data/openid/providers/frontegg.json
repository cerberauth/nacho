{
  "$schema": "https://schemas.cerberauth.com/openid/draft/2024-09/provider.schema.json",
  "name": "Frontegg",
  "abstract": "Frontegg is an Israeli B2B/B2C CIAM platform offering hosted login, enterprise SSO and M2M authentication for SaaS applications. It implements OpenID Connect by default as part of its hosted identity provider offering, exposing standard OIDC discovery, authorization code and client-credentials flows for both end-user and machine-to-machine authentication.",
  "identifier": "frontegg",
  "icon": {
    "contentUrl": "https://nacho.cerberauth.com/logos/frontegg.svg"
  },
  "website": "https://frontegg.com",
  "github": "https://github.com/frontegg",
  "license": "Proprietary",
  "nationality": "Israel",
  "featureList": [
    {
      "identifier": "implicit_grant",
      "status": "not_supported"
    },
    {
      "identifier": "authorization_code_grant",
      "status": "supported",
      "links": [
        "https://developers.frontegg.com/ciam/guides/management/frontegg-idp/via-oidc"
      ]
    },
    {
      "identifier": "pkce_extension",
      "status": "supported",
      "links": [
        "https://developers.frontegg.com/ciam/guides/management/frontegg-idp/native-hosted"
      ]
    },
    {
      "identifier": "par_extension",
      "status": "unknown"
    },
    {
      "identifier": "rar_extension",
      "status": "unknown"
    },
    {
      "identifier": "jar_extension",
      "status": "unknown"
    },
    {
      "identifier": "client_credentials_grant",
      "status": "supported",
      "links": [
        "https://developers.frontegg.com/guides/authentication/m2m/overview"
      ]
    },
    {
      "identifier": "password_grant",
      "status": "not_supported"
    },
    {
      "identifier": "refresh_token_grant",
      "status": "supported",
      "links": ["https://frontegg.com/blog/oauth-2-refresh-tokens"]
    },
